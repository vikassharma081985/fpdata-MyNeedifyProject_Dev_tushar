<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="SiteMaster.master.cs" Inherits="WSBillingMaster.Pages.SiteMaster" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head id="Head1" runat="server">
    <meta charset="utf-8">
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%--<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css">--%>
    <link href="../Css/bootstrap.min.css" rel="stylesheet" />
    <link href="../Css/AppStyle.css" rel="stylesheet" />
    <link href="../Css/chosen.css" rel="stylesheet" />
    <script src="../Js/jquery.min.js"></script>
    <script src="../Js/bootstrap.min.js"></script>
    <link href="../Css/admin.css" rel="stylesheet" />
    <title></title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<form id="form1" runat="server">
    <body id="myPage" data-spy="scroll" data-target=".navbar" data-offset="60">
        <style>
            .navbar {
                margin-bottom: 0;
                background-color: #f1f1f1;
                color: #999;
                min-height: 90px;
            }
        </style>
        <style>
            .Header {
                border: 1px solid #ccc;
                margin-top: 08%;
                text-align: center;
                font-weight: bold;
                padding: 15px;
            }

            .Content {
                border: 1px solid #ccc;
                margin-top: 2%;
                padding: 15px;
                color: #000;
            }

            .welcome-section {
                text-align: center;
            }

                .welcome-section h2 {
                    font-size: 26px;
                    margin: 20px 0;
                }

            /* Mobile view */
            @media (max-width: 767px) {
                .welcome-section {
                    padding: 0 5px;
                    text-align: left;
                }

                    .welcome-section h2 {
                        font-size: 8px;
                        line-height: 20px;
                        white-space: nowrap;
                        text-align: center;
                    }
            }
        </style>
        <nav class="navbar navbar-default navbar-fixed-top">
            <div class="container">
                <div class="navbar-header">
                    <div class="container">
                        <div class="row">
                            <div class="col-md-2">
                                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target="#myNavbar">
                                    <span class="icon-bar"></span>
                                    <span class="icon-bar"></span>
                                    <span class="icon-bar"></span>
                                </button>
                                <a class="navbar-brand" style="font-size: 28px; font-family: cursive; font-weight: 600;"
                                    href="#">
                                    <img src="../Images/system/mylogo.png" id="imgSellerLogo" runat="server" style="width: 117px; margin-left: 0%; margin-top: -20%;" />
                                </a>
                            </div>
                            <div class="col-md-2">
                                &nbsp;
                            </div>
                            <%--<div class="col-md-4">
                                <h2>Welcome,
                                    <asp:Label ID="lblEmployeeName" runat="server" Text="User"></asp:Label>
                                </h2>
                            </div>--%>
                            <div class="col-md-4 welcome-section">
                                <h2>Hi,
       
                                    <asp:Label
                                        ID="lblEmployeeName"
                                        runat="server"
                                        Text="User">
        </asp:Label>
                                </h2>
                            </div>
                            <div class="col-md-2">
                                &nbsp;
                            </div>
                            <div class="col-md-2">
                                <div class="collapse navbar-collapse" id="myNavbar">
                                    <ul class="nav navbar-nav navbar-right">
                                        <li><a href="UserDashboard.aspx" style="color: #000 !important">Home</a></li>
                                        <li>
                                            <asp:LinkButton
                                                ID="lnkLogout"
                                                runat="server"
                                                OnClick="lnkLogout_Click"
                                                Style="color: #000 !important">
                                                Logout
                                            </asp:LinkButton>
                                        </li>

                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <%--<div class="collapse navbar-collapse" id="myNavbar">
                    <ul class="nav navbar-nav navbar-right">
                        <li><a href="UserDashboard.aspx" style="color: #000 !important">Home</a></li>
                        <li>
                            <asp:LinkButton
                                ID="lnkLogout"
                                runat="server"
                                OnClick="lnkLogout_Click"
                                Style="color: #000 !important">
                                Logout
                            </asp:LinkButton>
                        </li>

                    </ul>
                </div>--%>
            </div>
        </nav>



        <div class="container-fluid" style="margin: 0px; padding: 0px; margin-top: 10px;">

            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>

        <script>
            function showmsg(msg) {
                $('#msgField').html('');
                $('#msgField').append(msg);
                $(".alert").css('background-color', '#04b076');
                $(".alert").removeClass("in").show();
                $(".alert").delay(1500).addClass("in").fadeOut(1000);
            }
            function showerrormsg(msg) {
                $('#msgField').html('');
                $('#msgField').append(msg);
                $(".alert").css('background-color', 'red');
                $(".alert").removeClass("in").show();
                $(".alert").delay(1500).addClass("in").fadeOut(1000);
            }
        </script>

    </body>
</form>
</html>
