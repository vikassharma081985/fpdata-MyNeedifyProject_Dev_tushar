    <script>
        var appURL = "<%= appURL %>";

        function CheckLoginDetails() {
            var UserName = $('[id$=txtUserName]').val().trim();
            var Password = $('[id$=txtPassword]').val();

            var RoleName = $('[id*=ddlRole] :selected').text();
            //$('[id*=hdnRole]').val(RoleName);
            var flag = true;
            if (UserName == "") {
                flag = false;
                $('[id$=txtUserName]').css('border', '1px solid red');
            }
            else {
                $('[id$=txtUserName]').css('border', '1px solid #ccc');
            }
            if (Password == "") {
                flag = false;
                $('[id$=txtPassword]').css('border', '1px solid red');
            }
            else {
                $('[id$=txtPassword]').css('border', '1px solid #ccc');
            }


            if (flag) {

                $('[id*=loader]').css('display', 'block');
                $('[id*=btnSubmit]').val('Please Wait');


                $.ajax({
                    type: "POST",
                    url: appURL+"Front/index.aspx/LoginDetails",
                    //url: "https://myneedify.com/Front/index.aspx/LoginDetails",
                    //url: "http://198.38.88.185:8082/Front/index.aspx/LoginDetails",
                    data: JSON.stringify({
                        UserName: UserName, Password: Password
                    }),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    async: true,
                    success: function (data) {
                        var UserInfo = $.parseJSON(data.d);
                        if (UserInfo.length > 0) {
                            $('[id$=lblUserName]').text('Hi, ' + UserInfo[0].FirstName);
                            $('[id$=LoggedinUser]').show();
                            if (UserInfo[0].OrgId !== null && UserInfo[0].OrgId !== undefined && UserInfo[0].OrgId !== "") {
                                $('[id$=SellerDashboard]').show();
                            }
                            else {
                                $('[id$=SellerDashboard]').hide();
                            }
                            $('[id$=NotLoggedIn]').hide();    // login/signup not display when user login
                            $('[id$=lnkLogin]').hide();
                            $('[id$=lnkLogout]').show();
                            $('[id$=MasterhdnUserId]').val(UserInfo[0].UserId);
                            BindCart();
                            sessionStorage.setItem("OrgId", UserInfo[0].OrgId);
                            sessionStorage.setItem("UserId", UserInfo[0].UserId);
                            loadEmployeeBookings(UserInfo[0].OrgId, UserInfo[0].UserId);
                            // Dynamically load notifications upon successful login
                            $.ajax({
                                type: "POST",
                                url: appURL + "Front/index.aspx/GetNotificationsData",
                                data: JSON.stringify({ UserId: UserInfo[0].UserId }),
                                contentType: "application/json; charset=utf-8",
                                dataType: "json",
                                success: function (notifData) {
                                    $('[id$=divNotificationsMobile]').html(notifData.d);
                                    $('[id$=divNotificationsDesktop]').html(notifData.d);
                                }
                            });

                            LoadUserAddresses(UserInfo[0].UserId);

                            $('#btnModalClose').click();
                            $("#bookingModal").modal("hide");
                            //location.reload();

                            //  window.location.href = 'Front/index.aspx';
                        }

                        else {
                            alert("User Name  & paasword is not correct");
                            $('[id*=loader]').css('display', 'none');
                            $('[id*=btnSubmit]').val('Login');
                            $('[id*=lblAlert]').css('display', 'block');
                            $('[id$=LoggedinUser]').hide();
                            $('[id$=SellerDashboard]').hide();
                            $('[id$=lnkLogin]').show();
                            $('[id$=lnkLogout]').hide();
                        }

                    },

                    failure: function (response) {
                        alert('fail');
                    },
                    error: function (response) {
                        alert(response.responseText);

                    }
                });
                return false;
            }
            else {
                return false;

            }
        }

        function LoadUserAddresses(userId) {
            if (!userId || userId === "0") {
                $('[id$=divUserAddresses]').html('');
                return;
            }

            $.ajax({
                type: "POST",
                url: appURL + "Front/index.aspx/GetAddressData",
                data: JSON.stringify({ UserId: userId }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (addressData) {
                    $('[id$=divUserAddresses]').html(addressData.d);
                }
            });
        }

        function LoadAddrStateDropdown(callback) {

            var ddlState = $("#ddlAddrState");

            $.ajax({
                type: "POST",
                url: appURL + "Front/index.aspx/GetStateMaster",
                data: "{}",
                contentType: "application/json; charset=utf-8",
                dataType: "json",

                success: function (r) {

                    console.log(r);

                    ddlState.empty();
                    ddlState.append('<option value="0">Please select state</option>');

                    $.each(r.d, function (i, item) {
                        ddlState.append(
                            $("<option>")
                                .val(item.Value)
                                .text(item.Text)
                        );
                    });

                    if (typeof callback === "function")
                        callback();
                },

                error: function (xhr, status, error) {
                    console.log(xhr);
                    console.log(status);
                    console.log(error);
                    console.log(xhr.responseText);
                }
            });
        }

        function OpenAddAddressModal() {
            var userId = $('[id$=MasterhdnUserId]').val();
            if (!userId || userId === "0") {
                alert("Please login to add an address.");
                $('#addPass').modal('hide');
                OpenLogin();
                return false;
            }

            ClearAddAddressForm();
            LoadAddrStateDropdown();
            $('#addAddressModal').modal('show');
            return false;
        }

        function ClearAddAddressForm() {
            $('#hdnAddrContactId').val('0');
            $('#txtAddrName, #txtAddrMobile, #txtAddrBuilding, #txtAddrPincode').val('').css('border', '1px solid #ccc');
            $('#ddlAddrState').val('0').css('border', '1px solid #ccc');
            $('#ddlAddrCity').empty().append('<option selected="selected" value="0">Please select city</option>').css('border', '1px solid #ccc');
            $('#ddlAddrLocality').empty().append('<option selected="selected" value="0">Please select locality</option>').css('border', '1px solid #ccc');
            $('#addrModalTitle').text('Add an address or pick-up point');
            $('#btnSaveAddress').text('Save Address');
        }

        function OpenEditAddressModal(elem) {
            var userId = $('[id$=MasterhdnUserId]').val();
            if (!userId || userId === "0") {
                alert("Please login to edit an address.");
                $('#addPass').modal('hide');
                OpenLogin();
                return false;
            }

            var $elem = $(elem);
            $('#hdnAddrContactId').val($elem.attr('data-id'));
            $('#txtAddrName').val($elem.attr('data-name'));
            $('#txtAddrMobile').val($elem.attr('data-mobile'));
            $('#txtAddrBuilding').val($elem.attr('data-building'));
            $('#txtAddrPincode').val($elem.attr('data-pincode'));

            // Store edit values to set after dropdowns load
            var editLocality = $elem.attr('data-locality') || '';
            var editCity = $elem.attr('data-city') || '';
            var editState = $elem.attr('data-state') || '';

            $('#txtAddrName, #txtAddrMobile, #txtAddrBuilding, #txtAddrPincode').css('border', '1px solid #ccc');
            $('#ddlAddrState, #ddlAddrCity, #ddlAddrLocality').css('border', '1px solid #ccc');

            // Load states first, then cascade to match saved values
            LoadAddrStateDropdown(function () {
                // Try to match state by text
                var stateMatched = false;
                $('#ddlAddrState option').each(function () {
                    if ($(this).text().trim().toLowerCase() === editState.trim().toLowerCase()) {
                        $('#ddlAddrState').val($(this).val());
                        stateMatched = true;
                        return false;
                    }
                });

                if (stateMatched && $('#ddlAddrState').val() !== '0') {
                    // Load cities for the selected state, then match city
                    $.ajax({
                        type: "POST",
                        url: appURL + "Front/index.aspx/GetCityMasterByStateID",
                        data: JSON.stringify({ stateID: parseInt($('#ddlAddrState').val()) }),
                        contentType: "application/json; charset=utf-8",
                        dataType: "json",
                        success: function (r) {
                            var ddlCity = $('#ddlAddrCity');
                            ddlCity.empty().append('<option selected="selected" value="0">Please select city</option>');
                            $.each(r.d, function () {
                                ddlCity.append($('<option></option>').val(this['Value']).html(this['Text']));
                            });
                            // Match city by text
                            ddlCity.find('option').each(function () {
                                if ($(this).text().trim().toLowerCase() === editCity.trim().toLowerCase()) {
                                    ddlCity.val($(this).val());
                                    return false;
                                }
                            });
                            // If city matched, load localities
                            if (ddlCity.val() !== '0') {
                                $.ajax({
                                    type: "POST",
                                    url: appURL + "Front/index.aspx/GetAreaMasterByCityID",
                                    data: JSON.stringify({ CityID: parseInt(ddlCity.val()) }),
                                    contentType: "application/json; charset=utf-8",
                                    dataType: "json",
                                    success: function (r2) {
                                        var ddlLoc = $('#ddlAddrLocality');
                                        ddlLoc.empty().append('<option selected="selected" value="0">Please select locality</option>');
                                        $.each(r2.d, function () {
                                            ddlLoc.append($('<option></option>').val(this['Value']).html(this['Text']));
                                        });
                                        // Match locality by text
                                        ddlLoc.find('option').each(function () {
                                            if ($(this).text().trim().toLowerCase() === editLocality.trim().toLowerCase()) {
                                                ddlLoc.val($(this).val());
                                                return false;
                                            }
                                        });
                                    }
                                });
                            }
                        }
                    });
                }
            });

            $('#addrModalTitle').text('Edit Address');
$('#btnSaveAddress').text('Update Address');

            $('#addAddressModal').modal('show');
            return false;
        }

        function resetModalElement(selector) {
            var $modal = $(selector);
            $modal.removeClass('in show').css('display', 'none').attr('aria-hidden', 'true');
            var modalData = $modal.data('bs.modal');
            if (modalData) {
                modalData.isShown = false;
                modalData.$backdrop = null;
            }
        }

        function cleanupModalBackdrops(forceAll) {
            if (forceAll) {
                $('.modal-backdrop').remove();
                $('body').removeClass('modal-open').css({ overflow: '', paddingRight: '' });
                return;
            }

            var openModalCount = $('.modal.in, .modal.show').filter(function () {
                return $(this).css('display') === 'block';
            }).length;
            var $backdrops = $('.modal-backdrop');

            if (openModalCount === 0) {
                $backdrops.remove();
                $('body').removeClass('modal-open').css({ overflow: '', paddingRight: '' });
            } else if ($backdrops.length > openModalCount) {
                $backdrops.slice(0, $backdrops.length - openModalCount).remove();
            }
        }

        function closeAddressModalAndShowLocation(userId) {
            resetModalElement('#addAddressModal');
            resetModalElement('#addPass');
            cleanupModalBackdrops(true);

            if (userId && userId !== "0") {
                LoadUserAddresses(userId);
            }

            setTimeout(function () {
                cleanupModalBackdrops(true);
                $('#addPass').modal('show');
            }, 50);
        }

        function ValidateAddAddressForm() {
            var isValid = true;
            var textFields = [
                { id: '#txtAddrName', label: 'Full Name' },
                { id: '#txtAddrMobile', label: 'Mobile' },
                { id: '#txtAddrBuilding', label: 'House / Building' },
                { id: '#txtAddrPincode', label: 'Pincode' }
            ];

            textFields.forEach(function (field) {
                var value = $(field.id).val().trim();
                if (value === "") {
                    isValid = false;
                    $(field.id).css('border', '1px solid red');
                } else {
                    $(field.id).css('border', '1px solid #ccc');
                }
            });

            // Validate dropdowns
            var ddlFields = [
                { id: '#ddlAddrState', label: 'State' },
                { id: '#ddlAddrCity', label: 'City' },
                { id: '#ddlAddrLocality', label: 'Locality' }
            ];

            ddlFields.forEach(function (field) {
                var value = $(field.id).val();
                if (!value || value === "0") {
                    isValid = false;
                    $(field.id).css('border', '1px solid red');
                } else {
                    $(field.id).css('border', '1px solid #ccc');
                }
            });

            if (!isValid) {
                alert("Please fill all required fields.");
                return false;
            }

            var mobile = $('#txtAddrMobile').val().trim();
            if (!/^\d{10}$/.test(mobile)) {
                $('#txtAddrMobile').css('border', '1px solid red');
                alert("Please enter a valid 10-digit mobile number.");
                return false;
            }

            var pincode = $('#txtAddrPincode').val().trim();
            if (!/^\d{6}$/.test(pincode)) {
                $('#txtAddrPincode').css('border', '1px solid red');
                alert("Please enter a valid 6-digit pincode.");
                return false;
            }

            return true;
        }

        function SaveNewAddress() {
            if (!ValidateAddAddressForm()) {
                return false;
            }

            var userId = $('[id$=MasterhdnUserId]').val();
            if (!userId || userId === "0") {
                alert("Please login to save address.");
                $('#addAddressModal').data('skipReturn', true);
                $('#addAddressModal').modal('hide');
                $('#addPass').modal('hide');
                cleanupModalBackdrops();
                OpenLogin();
                return false;
            }

            var contactId = $('#hdnAddrContactId').val();
            var isEdit = (contactId && contactId !== "0");

            var url = appURL + "Front/index.aspx/" + (isEdit ? "UpdateAddress" : "AddNewAddress");
            var postData = {
                UserId: userId,
                Name: $('#txtAddrName').val().trim(),
                Mobile: $('#txtAddrMobile').val().trim(),
                Building: $('#txtAddrBuilding').val().trim(),
                Locality: $('#ddlAddrLocality option:selected').text(),
                City: $('#ddlAddrCity option:selected').text(),
                State: $('#ddlAddrState option:selected').text(),
                Pincode: $('#txtAddrPincode').val().trim()
            };
            if (isEdit) {
                postData.ContactId = contactId;
            }

            $('#btnSaveAddress').prop('disabled', true).text(isEdit ? 'Updating...' : 'Saving...');

            $.ajax({
                type: "POST",
                url: url,
                data: JSON.stringify(postData),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (result) {
                    var responseVal = parseInt(result.d, 10);
                    if (responseVal > 0) {
                        ClearAddAddressForm();
                        closeAddressModalAndShowLocation(userId);
                    } else {
                        alert(isEdit ? "Unable to update address. It may already exist." : "This address already exists.");
                    }
                },
                error: function (response) {
                    alert("Unable to save address. Please try again.");
                },
                complete: function () {
                    $('#btnSaveAddress').prop('disabled', false).text(isEdit ? 'Update Address' : 'Save Address');
                }
            });

            return false;
        }
    </script>

    <script>
const API_BASE = "https://api.myneedify.com";
let pendingBookings=[];

function formatDate(value){

    return new Date(value)
        .toLocaleDateString();

}

function formatTime(time){

    return time.substring(0,5);

}
function attachEvents(){

    $(".btnApprove").click(function (e) {
e.preventDefault();
    var id = $(this).data("id");

    var comment = $("#comment_" + id).val();

    acceptBooking(id, comment);

});

$(".btnReject").click(function (e) {
e.preventDefault();
    var id = $(this).data("id");

    var txt = $("#comment_" + id);

    var comment = txt.val().trim();

    // Validation
    if (comment === "") {

        txt.css("border", "1px solid #d9534f");
        txt.focus();

        alert("Comments are required when rejecting a booking.");

        return;
    }

    rejectBooking(id, comment);

});
$(".booking-comment").on("input", function () {

    $(this).css("border", "");

});

}
function showBookings(){
    console.log("show bookings");
    let html="";

    pendingBookings.forEach(b=>{

        html+=`

        <div class="booking-card">

            <div class="booking-name">

                <span class="glyphicon glyphicon-user"></span> ${b.customerName}

            </div>

            <div>

                <span class="glyphicon glyphicon-earphone"></span> ${b.customerPhone}

            </div>

            <div>

                📅 ${formatDate(b.appointmentDate)}

            </div>

            <div>

                🕒 ${formatTime(b.startTime)}
                -
                ${formatTime(b.endTime)}

            </div>

            <div class="row booking-actions">

    <div class="col-sm-8">

        <textarea
    class="form-control booking-comment"
    id="comment_${b.appointmentId}"
    rows="2"
    placeholder="Comments (required for rejection)">
</textarea>

    </div>

    <div class="col-sm-4 text-right">

        <button
type="button"
            class="btn btn-danger btnReject"
            data-id="${b.appointmentId}">
            Reject
        </button>

        <button
type="button"
            class="btn btn-success btnApprove"
            data-id="${b.appointmentId}">
            Approve
        </button>

    </div>
</div>
</div>

        `;

    });

    document.getElementById("bookingList").innerHTML=html;

    attachEvents();

    $("#bookingModal").modal("show");

}

function closeModal (){
$("#bookingModal").modal("hide");
}

async function acceptBooking(id, comment) {
const orgId = sessionStorage.getItem("OrgId");
const userId = sessionStorage.getItem("UserId");
    try {

        await $.ajax({

            url: API_BASE + "/api/Appointment/AcceptBooking",

            type: "POST",
contentType: "application/json",
            data: JSON.stringify({
                appointmentId: id,
                comments: comment
            })

        });

        await loadEmployeeBookings(orgId,userId);

        showBookings();

    }
    catch (ex) {

        alert("Unable to approve booking.");

        console.error(ex);

    }

}
async function rejectBooking(id, comment) {
const orgId = sessionStorage.getItem("OrgId");
const userId = sessionStorage.getItem("UserId");
    try {

        await $.ajax({

            url: API_BASE + "/api/Appointment/RejectBooking",
contentType: "application/json",
            type: "POST",

            data: JSON.stringify({
                appointmentId: id,
                comments: comment
            })

        });

        await loadEmployeeBookings(orgId,userId);

        showBookings();

    }
    catch (ex) {

        alert("Unable to reject booking.");

        console.error(ex);

    }

}




async function loadEmployeeBookings(orgId, employeeId){

    const response=await fetch(
        `${API_BASE}/api/Appointment/GetEmployeeBookings?orgId=${orgId}&employeeId=${employeeId}`
    );

    const bookings=await response.json();

    pendingBookings=bookings.filter(
        x=>x.bookingStatus==="Pending"
    );

    updateNotification();
}
function updateNotification(){
    const badge=document.getElementById("bookingBadge");

    if(pendingBookings.length){

        badge.style.display="block";

        badge.innerText="You have "+pendingBookings.length+" booking requests";
        badge.onclick=showBookings;
    }
    else{

        badge.style.display="none";
    }

}

        function myFunction() {
            document.getElementById("myDropdown").classList.toggle("show");
        }

        //jQuery(window).load(function() {
        //    jQuery('#preloader').show();

        //});
        $(document).ready(function () {


            $(".dropdown").hover(
                function () {
                    $('.dropdown-menu', this).not('.in .dropdown-menu').stop(true, true).slideDown("400");
                    $(this).toggleClass('open');
                },
                function () {
                    $('.dropdown-menu', this).not('.in .dropdown-menu').stop(true, true).slideUp("400");
                    $(this).toggleClass('open');
                }
            );

            $('#addPass').on('show.bs.modal', function () {
                var userId = $('[id$=MasterhdnUserId]').val();
                if (userId && userId !== "0") {
                    LoadUserAddresses(userId);
                }
            });

            $('#addAddressModal').on('hidden.bs.modal', function () {
                if ($('#addAddressModal').data('skipReturn')) {
                    $('#addAddressModal').removeData('skipReturn');
                    cleanupModalBackdrops(true);
                    return;
                }

                setTimeout(function () {
                    cleanupModalBackdrops(false);
                    var userId = $('[id$=MasterhdnUserId]').val();
                    if (userId && userId !== "0") {
                        LoadUserAddresses(userId);
                    }
                }, 150);
            });

            $('#addPass').on('hidden.bs.modal', function () {
                cleanupModalBackdrops(true);
            });

            // Delegate change events for dynamically created dropdown options
            // (using document-level delegation since dropdowns are inside a modal)

            // State change → load cities
            $('#ddlAddrState').change(function () {
                var stateID = $(this).val();
                var ddlCity = $('#ddlAddrCity');
                var ddlLocality = $('#ddlAddrLocality');
                ddlCity.empty().append('<option selected="selected" value="0">Please select city</option>');
                ddlLocality.empty().append('<option selected="selected" value="0">Please select locality</option>');
                $('#txtAddrPincode').val('');

                if (stateID && stateID !== "0") {
                    $.ajax({
                        type: "POST",
                        url: appURL + "Front/index.aspx/GetCityMasterByStateID",
                        data: JSON.stringify({ stateID: parseInt(stateID) }),
                        contentType: "application/json; charset=utf-8",
                        dataType: "json",
                        success: function (r) {
                            $.each(r.d, function () {
                                ddlCity.append($('<option></option>').val(this['Value']).html(this['Text']));
                            });
                        }
                    });
                }
            });

            // City change → load localities/areas
            $('#ddlAddrCity').change(function () {
                var cityID = $(this).val();
                var ddlLocality = $('#ddlAddrLocality');
                ddlLocality.empty().append('<option selected="selected" value="0">Please select locality</option>');
                $('#txtAddrPincode').val('');

                if (cityID && cityID !== "0") {
                    $.ajax({
                        type: "POST",
                        url: appURL + "Front/index.aspx/GetAreaMasterByCityID",
                        data: JSON.stringify({ CityID: parseInt(cityID) }),
                        contentType: "application/json; charset=utf-8",
                        dataType: "json",
                        success: function (r) {
                            $.each(r.d, function () {
                                ddlLocality.append($('<option></option>').val(this['Value']).html(this['Text']));
                            });
                        }
                    });
                }
            });

            // Locality change → auto-fill pincode
            $('#ddlAddrLocality').change(function () {
                var pincode = $(this).val();
                if (pincode && pincode !== "0") {
                    $('#txtAddrPincode').val(pincode);
                } else {
                    $('#txtAddrPincode').val('');
                }
            });
        });

        $(document).ready(function () {
            if ($(window).width() <= 600) {
                $('#MyNavbar').removeClass('navbar-fixed-top');
            }

        });
$("#bookingModal").on("hidden.bs.modal", function () {

    loadEmployeeBookings();   // Refresh pending bookings

});
    </script>
    <script>
        var flag = true;
        $(document).ready(function () {

            $("#lblUserName, #categories").mouseenter(function () {
                $(".dropdown-content").show();
            });


            //$("#categories").mouseleave(function () {
            //    debugger
            //     $(".dropdown-content").hide();
            //    $(".dropdown-content").show();
            //});

            // Close the dropdown if the user clicks outside of it
            window.onclick = function (event) {


                if (!event.target.matches('#lblUserName')) {
                    var dropdowns = document.getElementsByClassName("dropdown-content");
                    var i;
                    for (i = 0; i < dropdowns.length; i++) {
                        var openDropdown = dropdowns[i];
                        $(".dropdown-content").hide();
                        //if (openDropdown.classList.contains('show')) {
                        //    openDropdown.classList.remove('show');
                        //}
                    }
                }
            }

            $(".dropdown").click(
                function () {
                    if (flag) {
                        $('.dropdown-menu', this).stop(true, true).slideDown("slow");
                        $(this).toggleClass('open');
                        flag = false;
                    } else {
                        $('.dropdown-menu', this).stop(true, true).slideUp("slow");
                        $(this).toggleClass('open');
                        flag = true;
                    }
                });
        });
        //var j = jQuery.noConflict();
        function OpenLogin() {
            closeNav();
            //j('#myModal').modal('show');
            jQuery.noConflict();
            $('#myModal').modal('show');
            return false;
        }


        function lnkLogout_ClickNew() {
            sessionStorage.clear();
            $.ajax({
                type: "POST",
                url: appURL + "Front/index.aspx/Logout",
                data: JSON.stringify({ TestId: "0" }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    window.location.href = appURL + "Front/Index.aspx";
                },
                error: function (data) {
                    window.location.href = appURL + "Front/Index.aspx";
                }
            });
            return false;
        }


    </script>



