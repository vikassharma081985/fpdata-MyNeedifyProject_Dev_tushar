        <!-------------location modal----------------->

<div class="modal fade" id="addPass" role="dialog" style="top: 10%;">
  <div class="modal-dialog">
    <div class="modal-content LoginPanel">

      <!-- HEADER -->
      <div class="modal-header">
        <span class="modal-title-custom">Choose your location</span>
        <button type="button" class="close" data-dismiss="modal">&times;</button>
      </div>

      <!-- BODY -->
      <div class="modal-body">

        <p style="font-size:13px;color:#666;">
          Select a delivery location to see product availability and delivery options
        </p>

        <div id="divUserAddresses" runat="server"></div>

        <!-- FOOTER LINKS -->
        <div class="bottom-links">
          <a href="#">See all</a>
          <a href="#" onclick="return OpenAddAddressModal();">Add an address or pick-up point</a>
        </div>

      </div>

    </div>
  </div>
</div>

        <!-------------add address modal----------------->

<div class="modal fade" id="addAddressModal" role="dialog" style="top: 10%;" data-backdrop="false">
  <div class="modal-dialog">
    <div class="modal-content LoginPanel">

      <div class="modal-header">
        <span class="modal-title-custom" id="addrModalTitle">Add an address or pick-up point</span>
        <button type="button" class="close" data-dismiss="modal">&times;</button>
      </div>

      <div class="modal-body">
        <input type="hidden" id="hdnAddrContactId" value="0" />
        <div class="row">
          <div class="col-md-6 address-form-group">
            <label for="txtAddrName">Full Name</label>
            <input type="text" id="txtAddrName" maxlength="50" placeholder="Full Name" />
          </div>
          <div class="col-md-6 address-form-group">
            <label for="txtAddrMobile">Mobile</label>
            <input type="text" id="txtAddrMobile" maxlength="10" placeholder="Mobile Number" />
          </div>
          <div class="col-md-6 address-form-group">
            <label for="txtAddrBuilding">House / Building</label>
            <input type="text" id="txtAddrBuilding" maxlength="50" placeholder="House Number / Building / Apartment" />
          </div>
          <div class="col-md-6 address-form-group">
            <label for="ddlAddrState">State</label>
            <select id="ddlAddrState" class="form-control">
              <option selected="selected" value="0">Please select state</option>
            </select>
          </div>
          <div class="col-md-6 address-form-group">
            <label for="ddlAddrCity">City</label>
            <select id="ddlAddrCity" class="form-control">
              <option selected="selected" value="0">Please select city</option>
            </select>
          </div>
          <div class="col-md-6 address-form-group">
            <label for="ddlAddrLocality">Locality / Area</label>
            <select id="ddlAddrLocality" class="form-control">
              <option selected="selected" value="0">Please select locality</option>
            </select>
          </div>
          <div class="col-md-6 address-form-group">
            <label for="txtAddrPincode">Pincode</label>
            <input type="text" id="txtAddrPincode" maxlength="6" placeholder="Pincode" readonly="readonly" style="background-color:#f5f5f5;" />
          </div>
        </div>

        <div class="address-form-actions">
          <button type="button" class="btn-cancel-address" data-dismiss="modal">Cancel</button>
          <button type="button" id="btnSaveAddress" class="btn-save-address" onclick="return SaveNewAddress();">Save Address</button>
        </div>
      </div>

    </div>
  </div>
</div>

        <!-------------forgot pass modal----------------->
<div class="modal fade" id="forgotPass" role="dialog" style="top: 10%;">
  <div class="modal-dialog">
    <div class="modal-content LoginPanel">
      <div class="modal-header"></div>
      <div class="modal-body">
        <div class="col-lg-10 col-md-10 col-xs-12 col-sm-12">
          <button type="button" class="close" data-dismiss="modal">&times;</button>
          <div
            class="login-form"
            style="background-color: #fff; border: 1px solid #ccc; padding: 5%; height: 205px; border-radius: 5px;"
          >
            <div style="float: left; color: #666; font-size: 20px; margin-bottom: 10px;">
              Sign Up
            </div>

            <br /><br />

            <div class="form-group">
              <input
                type="email"
                id="forgotEmail"
                class="form-control"
                placeholder="Enter Your Email"
              />
            </div>

            <button
              type="button"
             style="background-color: #F6861F; color: #fff; height: 35px; padding: 7px; width: 100%; text-align: center; border: none;" onclick="openOtpModal()"
            >
              Submit
            </button>

            <br /><br />
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!------------------------------- OTP Modal----------------------------->
<div class="modal fade" id="otpModal" role="dialog" style="top: 10%;">
  <div class="modal-dialog">
    <div class="modal-content LoginPanel">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal">&times;</button>
        <h4 class="modal-title" style="text-align:center; color:#555;">Enter OTP</h4>
      </div>

      <div class="modal-body text-center">
        <p style="color:#777;">Please enter the 4-digit OTP sent to your email.</p>

        <div id="otpInputs" style="display:flex; justify-content:center; gap:10px; margin:20px 0;">
          <input type="number" maxlength="1" class="otp-box" />
          <input type="number" maxlength="1" class="otp-box" />
          <input type="number" maxlength="1" class="otp-box" />
          <input type="number" maxlength="1" class="otp-box" />
        </div>

        <button type="button"  style="background-color: #F6861F; color: #fff; height: 35px; padding: 7px; width: 100%; text-align: center; border: none; width:100%;" onclick="verifyOtp()">
          Verify
        </button>
      </div>
    </div>
  </div>
</div>


        <!------------- SET NEW PASSWORD MODAL--------------------------->
<div class="modal fade" id="setPasswordModal" role="dialog" style="top: 10%;">
  <div class="modal-dialog">
    <div class="modal-content LoginPanel">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal">&times;</button>
        <h4 class="modal-title" style="text-align:center; color:#555;">Set New Password</h4>
      </div>

      <div class="modal-body">
        <div class="form-group">
          <label for="newPassword">New Password</label>
          <input
            type="password"
            id="newPassword"
            class="form-control"
            placeholder="Enter new password"
          />
        </div>

        <div class="form-group">
          <label for="confirmPassword">Confirm Password</label>
          <input
            type="password"
            id="confirmPassword"
            class="form-control"
            placeholder="Confirm new password"
          />
        </div>

        <button
          type="button"
          class="btn btn-success"
          style="width:100%; background-color:#28a745; border:none;"
          onclick="setPassword()"
        >
          Save Password
        </button>
      </div>
    </div>
  </div>
</div>


<script>
    // Open OTP Modal
    function openOtpModal() {
        sendOtp();
        $("#forgotPass").modal("hide");
        setTimeout(() => {
            $("#otpModal").modal("show");
            $(".otp-box:first").focus();
        }, 400);
    }

    // OTP auto-move focus
    $(document).on("keyup", ".otp-box", function (e) {
        if (this.value.length === 1 && e.keyCode !== 8) {
            $(this).next(".otp-box").focus();
        } else if (e.keyCode === 8) {
            $(this).prev(".otp-box").focus();
        }
    });

    //  Verify OTP & Open Set Password Modal
    function verifyOtp() {
        var email = $('[id$=forgotEmail]').val().trim();
        let otp = "";
        $(".otp-box").each(function () {
            otp += $(this).val();
        });

        if (otp.length === 4) {
            $.ajax({
                    type: "POST",
                    url: appURL+"Front/ForgotPassword.aspx/VerifyOtp",
                    data: JSON.stringify({ email: email, otp: otp }),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (response) {
                        if (response.d) {
                            $("#otpModal").modal("hide");
                                setTimeout(() => {
                                    $("#setPasswordModal").modal("show");
                                }, 400);
                        } else {
                            alert(response.d);
                        }
                    },
                    error: function (err) {
                        alert(err.responseText);
                    }
                });
            
        } else {
            alert("Please enter all 4 digits.");
        }
    }

    //  Save Password
    function setPassword() {
        let newPass = $("#newPassword").val();
        let confirmPass = $("#confirmPassword").val();
        var email = $('[id$=forgotEmail]').val().trim();
        if (newPass === "" || confirmPass === "") {
            alert("Please fill in both fields.");
        } else if (newPass !== confirmPass) {
            alert("Passwords do not match!");
        } else {
            $.ajax({
        type: "POST",
        url: appURL+"Front/ForgotPassword.aspx/SetPassword",
        data: JSON.stringify({ email: email, password: newPass }),
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        success: function (response) {
            if (response.d === "SUCCESS") {
                alert("Password successfully set!");
                $("#setPasswordModal").modal("hide");
            }
            else{
                alert("Password change failed !");
                $("#setPasswordModal").modal("hide");
            }
        },
        error: function (err) {
            alert(err.responseText);
        }
    });
            
        }
    }
function sendOtp() {
    var email = $('[id$=forgotEmail]').val().trim();
    //var email = $("#txtForgotEmail").val();

    if (!email) {
        alert("Please enter email");
        return;
    }

    $.ajax({
        type: "POST",
        url: appURL+"Front/ForgotPassword.aspx/SendOtp",
        data: JSON.stringify({ email: email }),
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        success: function (response) {
            if (response.d === "SUCCESS") {
                openOtpModal();
            } else {
                alert(response.d);
            }
        },
        error: function (err) {
            alert(err.responseText);
        }
    });
}

</script>


        <!----------------forgot pass modal end -------------------------->


        <%-- cart --%>
        <!-- Modal -->
        <div class="Layout" style="display: none;"></div>
        <div id="myCart" style="background-color: #fff; height: 100%; width: 450px; position: fixed; top: 0px; right: 0px; z-index: 99999999; padding: 0px; border: 1px solid #ccc; display: none;">
            <div style="width: 100%; background-color: #7C519B; color: #fff; padding: 0px; height: 45px; padding-left: 40px; padding-top: 10px; padding-right: 20px; font-size: 22px;">
                My Cart(<span id="CartCtr"></span>) <a href="#" onclick="CloseCart();"><i class="fa fa-close" style="float: right; font-size: 16px; color: #fff;"></i></a>
            </div>
            <div style="float: left; width: 100%; padding: 15px; margin-left: 10px;">

                <div class="container-fluid" id="CartItems" style="height: 350px; overflow: auto;">

                    <div id="NoItem" style="margin-top: 15%; display: none;">
                        <div class="col-md-12 text-center">
                            <img src="../Images/System/Sadface.png" />
                        </div>
                        <div class="col-md-12 text-center" style="font-size: 20px; color: #999; padding-top: 20px;">
                            Oops ! No Item Found in Cart.
                        </div>
                    </div>
                </div>



            </div>
            <a href="<%=appURL%>Front/Checkout.aspx" style="position: absolute; bottom: 0; left: 5%; width: 100%;">
                <input type="button" style="width: 100%; height: 60px; background-color: #F6861F; background-image: none; border-bottom: none;" class="btn btn-primary" value="Proceed to Checkout" /></a>

        </div>

        <script>
            function OpenCart() {
                BindCart();
                $('#myCart').fadeIn(200);
                $('.Layout').fadeIn(200);
            }

            function CloseCart() {
                $('#myCart').fadeOut(200);
                $('.Layout').fadeOut(200);
            }

            function MMWomen() {
                $('#MegaMenuMen').fadeOut(200);
                $('#MegaMenuWomen').fadeToggle(200);
            }
            function MMWomenOut() {

                $('#MegaMenuWomen').hide();
            }
            function MMWomenIN() {
                $('#MegaMenuWomen').show();
            }

            function MMMen() {
                $('#MegaMenuWomen').fadeOut(200);
                $('#MegaMenuMen').fadeToggle(200);
            }

            function MMMenOut() {

                $('#MegaMenuMen').hide();
            }
            function MMMenIN() {

                $('#MegaMenuMen').show();
            }

            function Logout() {
                var Test_id = "1";
                $.ajax({
                    url: appURL + "Front/index.aspx/Logout",
                    async: true,
                    data: '{TestId:"' + Test_id + '"}',
                    contentType: "application/json; charset=utf-8",
                    type: "POST", // data has to be Posted 
                    timeout: 120000,
                    dataType: "json",
                    success: function (result) {

                    }
                });
            }

            $(document).ready(function () {
                //GetMenu();
                BindCart()
            });
            function GetMenu() {
                $.ajax({
                    url: "../Front/Index.aspx/GetMenu",
                    contentType: "application/json; charset=utf-8",
                    type: "POST", // data has to be Posted 
                    timeout: 120000,
                    dataType: "json",
                    success: function (result) {
                        $('#divmenu').html(result.d);
                    }
                });
            }
            function BindCart() {
                var UserId = $('[id$=MasterhdnUserId]').val();
                if (UserId != "0") {
                    $.ajax({
                        url: appURL + "Front/index.aspx/BindCart",
                        //url: "http://localhost:46692/Front/index.aspx/BindCart",
                        async: true,
                        data: '{UserId:"' + UserId + '"}',
                        contentType: "application/json; charset=utf-8",
                        type: "POST", // data has to be Posted 
                        timeout: 120000,
                        dataType: "json",
                        success: function (result) {
                            var ds = $.parseJSON(result.d)
                            var CartCtr = parseInt(ds.Table[0].CartCtr);
                            var CartData = ds.Table1;
                            if (CartCtr > 0) {
                                $('.Cart-Counter').html(CartCtr);
                                $('#CartCtr').html(CartCtr);
                                $('.Cart-Counter').show();

                                var html = '';
                                for (var i = 0; i < CartData.length; i++) {
                                    html += '<div class="row" style="margin-bottom: 30px;">';
                                    html += '<div class="col-md-5">';
                                    html += '<img src="'+ appURL + '/Images/Items/' + CartData[i].ItemImage + '" class="img-thumbnail img-responsive" style="max-height: 150px;" />';
                                    html += '<p style="padding: 15px;text-align: center;empty-cells: hide;color: red;"><a href="#" style="color:red;text-decoration:none;" onClick="RemoveCartItem(' + CartData[i].CartId + ',this);">Remove</a><p>';
                                    html += '</div>';
                                    html += '<div class="col-md-7">';
                                    html += '<h4>' + CartData[i].ItemName + '</h4>';
                                    html += '<strong>Quantity : </strong>';
                                    html += '<input type="text" value="' + CartData[i].ItemQuantity + '" style="width: 75px;" class="form-control" />';
                                    html += '<br />';
                                    html += '<span style="font-size: 22px;"><strong><i class="fa fa-inr"></i>' + parseInt(CartData[i].ItemPrice) * parseInt(CartData[i].ItemQuantity) + ' </strong></span>';
                                    html += '</div>';
                                    html += '<hr />';
                                    html += '</div>';
                                }
                                $('[id$=CartItems]').html(html);
                                $('[id$=NoItem]').hide();
                            }
                            else {
                                $('.Cart-Counter').html('');
                                $('.Cart-Counter').hide();
                                $('[id$=NoItem]').show();

                            }
                        }
                    });
                }
                else {
                    $('[id$=NoItem]').show();
                }
            }

            function RemoveCartItem(CartId, ctrl) {
                $.ajax({
                    url: appURL + "Front/index.aspx/RemoveCartItem",
                    async: false,
                    data: '{CartId:"' + CartId + '"}',
                    contentType: "application/json; charset=utf-8",
                    type: "POST", // data has to be Posted 
                    timeout: 120000,
                    dataType: "json",
                    success: function (result) {
                        $(ctrl).parent().parent().parent().remove();
                        BindCart();
                    }
                });
            }


            function ValidateSignup() {
                var FName = $('[id$=txtFirstName]').val().trim();
                var LName = $('[id$=txtLastName]').val().trim();
                var Email = $('[id$=txtEmail]').val().trim();
                var Mobile = $('[id$=txtMobile]').val().trim();
                var Password = $('[id$=txtPassword1]').val().trim();
                var flag = true;
                if (FName == "") {
                    flag = false;
                    $('[id$=txtFirstName]').css('border', '1px solid red');
                }
                else {
                    $('[id$=txtFirstName]').css('border', '1px solid #ccc');
                }

                if (LName == "") {
                    flag = false;
                    $('[id$=txtLastName]').css('border', '1px solid red');
                }
                else {
                    $('[id$=txtLastName]').css('border', '1px solid #ccc');
                }
                if (Email == "") {
                    flag = false;
                    $('[id$=txtEmail]').css('border', '1px solid red');
                }
                else {
                    $('[id$=txtEmail]').css('border', '1px solid #ccc');
                }
                if (Mobile == "") {
                    flag = false;
                    $('[id$=txtEmail]').css('border', '1px solid red');
                }
                else {
                    $('[id$=txtEmail]').css('border', '1px solid #ccc');
                }
                if (Password == "") {
                    flag = false;
                    $('[id$=txtPassword1]').css('border', '1px solid red');
                }
                else {
                    $('[id$=txtPassword1]').css('border', '1px solid #ccc');
                }
                if (flag) {
                    //return true;
                    $.ajax({
                        //url: "https://myneedify.com//Front/index.aspx/btnSignup",
                        url: appURL+"Front/index.aspx/btnSignup",
                        async: false,
                        data: '{txtFirstName:"' + FName + '", txtLastName:"' + LName + '", txtMobile:"' + Mobile + '", txtEmail:"' + Email + '", txtPassword1:"' + Password + '"}',
                        contentType: "application/json; charset=utf-8",
                        type: "POST", // data has to be Posted 
                        timeout: 120000,
                        dataType: "json",
                        success: function (result) {
                            var dt = $.parseJSON(result.d);
                            if (dt == '0') {
                                alert('User not created.');
                            }
                            else {
                                alert('User created successfully.');
                                window.location.href = window.location.href;
                            }
                        }
                    });
                }
                else {
                    return false;
                }
            }

            function Search() {
                var txtGlobalSearch = $('[id$=txtGlobalSearch]').val().trim();
                if (txtGlobalSearch != "") {
                    //window.location.href = "https://myneedify.com//Front/Search.aspx?Search=" + txtGlobalSearch;
                    window.open(appURL + "Front/Search.aspx?Search=" + txtGlobalSearch);
                    //window.open("https://myneedify.com/Front/Search.aspx?Search=" + txtGlobalSearch);
                }
                else {
                    return;
                }
            }
        </script>
