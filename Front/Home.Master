    <script>
        function AddToCart(ItemId) {

            var UserId = $('[id$=MasterhdnUserId]').val();

            if (UserId == "" || UserId == undefined)
                UserId = "0";

            $.ajax({
                url: appURL + "/Front/index.aspx/AddItemToCart",
                async: true,
                type: "POST",
                contentType: "application/json; charset=utf-8",
                dataType: "json",

                data: '{ItemId:"' + ItemId + '",UserId:"' + UserId + '",Qty:"1"}',

                success: function (result) {

                    // refresh + open cart
                    BindCart();
                    OpenCart();
                },

                error: function (err) {
                    console.log(err);
                    alert("Cart API call failed");
                }
            });

        }
    </script>



