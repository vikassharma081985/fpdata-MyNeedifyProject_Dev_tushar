            /* FIX NAVBAR STRETCH ON MOBILE PROFILE DROPDOWN */
@media (max-width: 991.98px) {

    .mobile-topbar {
        position: relative;
        overflow: visible;
    }

    .mobile-topbar .dropdown {
        position: static;
    }

    .mobile-topbar .dropdown-menu {
        position: absolute !important;
        top: 100% !important;
        right: 0;
        left: auto;
        transform: none !important;
        min-width: 180px;
        z-index: 1055;
    }

    /* prevent navbar height jump */
    .navbar {
        align-items: center;
    }
}
