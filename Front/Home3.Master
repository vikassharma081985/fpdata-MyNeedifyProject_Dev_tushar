                            <div class="login-form" style="background-color: #fff; border: 1px solid #ccc; padding: 5%; height: 405px; border-radius: 5px;">
                                <div style="float: left; color: #666; font-size: 20px; margin-bottom: 10px;">sign up </div>

                                <br />
