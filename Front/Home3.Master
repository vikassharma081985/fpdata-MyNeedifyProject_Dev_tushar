      <style>
    body {
      background-color: #f8f9fa;
      font-family: 'Poppins', sans-serif;
    }

    .navbar {
      background-color: #fff;
      /* box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1); */
      padding: 0.3rem 1rem; /* reduced navbar height */
    }

    .navbar-brand {
      font-weight: 700;
      color: #0AA6BF !important;
      font-size: 18px;
      text-transform: uppercase;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .navbar-brand img {
      height: 60px;
    }

    .navbar-nav .nav-link {
      color: #212529;
      font-weight: 600;
      margin: 0 8px;
      text-transform: uppercase;
      font-size: 14px;
    }

    .navbar-nav .nav-link:hover {
      color: #0AA6BF;
    }

    .dropdown-menu {
      border: none;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
      border-radius: 0;
      margin-top: 0;
    }

    .dropdown-item:hover {
      background-color: #f8f9fa;
      color: #0AA6BF;
    }

    /* Search Row */
    .search-row {
      background-color: #fff;
      padding: 8px 0; /* smaller height */
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
      display: flex;
      justify-content: center;
      align-items: center;
    }
    

    .search-box {
      background-color: #f5f5f6;
      border-radius: 4px;
      padding: 5px 10px;
      display: flex;
      align-items: center;
      width: 100%;
      margin-left: 20px;
      margin-right: 20px;
    }

    .search-box input {
      border: none;
      background: transparent;
      width: 100%;
      outline: none;
      font-size: 14px;
    }

    .right-icons {
      display: flex;
      align-items: center;
    }

    .right-icons div {
      text-align: center;
      margin-left: 20px;
      font-size: 13px;
      color: #212529;
    }

    .right-icons i {
      font-size: 18px;
      display: block;
    }

    .login-buttons .btn {
      font-size: 13px;
      margin-left: 8px;
      font-weight: 600;
      border-radius: 20px;
      padding: 4px 10px;
    }

  /* Disable hover effect for buttons */
.btn-admin:hover {
  background-color: #0AA6BF !important;
  color: #fff !important;
}

.btn-seller:hover {
  background-color: #F48B1E !important;
  color: #fff !important;
}

.btn-login:hover {
  background-color: #8EC243 !important;
  color: #fff !important;
}


