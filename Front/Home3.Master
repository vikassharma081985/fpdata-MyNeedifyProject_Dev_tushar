            font-size: 10px;
        }

        .category-card p {
            font-size: 0.7rem;
        }

        .product-card p {
            font-size: 0.8rem;
        }

        .product-card .fw-bold {
            font-size: 0.9rem;
        }

        .product-card button {
            font-size: 0.75rem;
            padding: 6px 8px;
        }
      .list-unstyled {
    font-size: 12px;
}
